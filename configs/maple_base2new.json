{
  "_comment": "Base-to-new: train on {glioma, meningioma}, test base and new={notumor, pituitary}; H = harmonic mean.",
  "model": "maple",
  "k": 2,
  "optimizer": "sgd",
  "lr": 0.0035,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "warmup_lr": 1e-05,
  "epochs": 10,
  "batch_size": 16,
  "patience": 10,
  "n_ctx": 2,
  "prompt_depth": 9,
  "ctx_init": "a photo of a",
  "clip_backend": "open_clip",
  "freeze_clip": true,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "mixed_precision": false,
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "protocol": "base2new",
  "out_dir": "runs/maple_base2new"
}