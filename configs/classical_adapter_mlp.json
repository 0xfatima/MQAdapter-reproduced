{
  "_comment": "Ablation: same MQAdapter topology (projections, attention, residual, γ) but f_φ is an 8→8 MLP, not a VQC.",
  "model": "classical_adapter",
  "clip_backend": "open_clip",
  "k": 2,
  "n_qubits": 8,
  "gamma": 0.001,
  "adapt_layers": [6, 7, 8, 9, 10, 11],
  "quantum_map": "mlp",
  "mlp_hidden": 8,
  "freeze_clip": true,
  "batch_size": 8,
  "epochs": 20,
  "lr": 0.001,
  "weight_decay": 0.01,
  "scheduler": "cosine",
  "patience": 6,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "out_dir": "runs/classical_adapter_mlp"
}
