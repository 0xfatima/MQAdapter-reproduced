{
  "_comment": "Paper MQAdapter, K=3 of 4 classes as semantic anchors.",
  "model": "mqadapter",
  "clip_backend": "open_clip",
  "k": 3,
  "n_qubits": 8,
  "gamma": 0.001,
  "adapt_layers": [6, 7, 8, 9, 10, 11],
  "quantum_map": "vqc",
