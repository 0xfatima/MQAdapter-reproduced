  "freeze_clip": true,
  "batch_size": 8,
  "epochs": 20,
  "lr": 0.001,
  "weight_decay": 0.01,
  "scheduler": "cosine",
  "patience": 6,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "mixed_precision": false,
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "out_dir": "runs/mqadapter_k3"
}
