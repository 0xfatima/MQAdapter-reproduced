{
  "_comment": "Paper setting: MQAdapter plugged into MaPLe. gamma=0.001 as in the paper for MaPLe; K in {2,3,4} on 4 classes (paper K=5 needs >=5 classes).",
  "model": "maple_mqadapter",
  "k": 2,
  "n_qubits": 8,
  "gamma": 0.001,
  "adapt_layers": [
    6,
    7,
    8,
    9,
    10,
    11
  ],
  "quantum_map": "vqc",
  "crz_dir": "control_first",
  "optimizer": "sgd",
  "lr": 0.0035,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "warmup_lr": 1e-05,
  "epochs": 10,
  "batch_size": 16,
  "patience": 10,
  "n_ctx": 2,
  "prompt_depth": 9,
  "ctx_init": "a photo of a",
  "clip_backend": "open_clip",
  "freeze_clip": true,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "mixed_precision": false,
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "protocol": "all",
  "out_dir": "runs/maple_mqadapter_k2"
}