  "warmup_lr": 1e-05,
  "epochs": 10,
  "batch_size": 16,
  "patience": 10,
  "n_ctx": 2,
  "prompt_depth": 9,
  "ctx_init": "a photo of a",
  "clip_backend": "open_clip",
  "freeze_clip": true,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "mixed_precision": false,
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "protocol": "all",
  "out_dir": "runs/maple"
