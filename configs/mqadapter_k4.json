{
  "_comment": "K=4 CONTROL: retrieves every MRI class. Coarse Top-K cannot filter a subset. Useful control, not evidence of retrieval.",
  "model": "mqadapter",
  "clip_backend": "open_clip",
  "k": 4,
  "n_qubits": 8,
  "gamma": 0.001,
  "adapt_layers": [6, 7, 8, 9, 10, 11],
  "quantum_map": "vqc",
  "crz_dir": "control_first",
  "freeze_clip": true,
  "batch_size": 8,
  "epochs": 20,
  "lr": 0.001,
  "weight_decay": 0.01,
  "scheduler": "cosine",
  "patience": 6,
  "val_ratio": 0.15,
  "seed": 0,
  "device": "auto",
  "mixed_precision": false,
  "num_workers": 4,
  "download_clip": true,
  "data_root": "data/brain_tumor_mri",
  "out_dir": "runs/mqadapter_k4"
}
